# =============================================================================
# Orcastra lab all-in-one — env.example
# Salin ke .env lalu isi. JANGAN commit .env / CREDENTIALS.txt / token Vault.
# Generate rahasia: openssl rand -base64 36 | tr -d '\n'
# =============================================================================

# Nama project Compose (lab box memakai "orcastra")
COMPOSE_PROJECT_NAME=orcastra

# --- Origin yang diketik di browser (WAJIB konsisten) ---
# Jalur A laptop:  http://localhost:4321
# Jalur B box:     https://sia.caracal-bee.ts.net
# Semua AUTH_URL / NEXTAUTH_URL / CORS / AUTHENTIK_HOST / brand / issuer
# harus cocok dengan URL ini. Campur localhost + MagicDNS = OIDC rusak.
AUTH_ORIGIN=

# extra_hosts di compose. Jalur A: biarkan default (host.docker.internal).
# Jalur B box lab: AUTH_HOST=sia.caracal-bee.ts.net  AUTH_HOST_IP=<Tailscale IP>
AUTH_HOST=host.docker.internal
AUTH_HOST_IP=host-gateway

# --- Authentik (image pin 2026.8.0 di compose; prod SSO adalah 2026.2.1) ---
PG_DB=authentik
PG_USER=authentik
PG_PASS=
AUTHENTIK_SECRET_KEY=
# Email + password akun bootstrap akadmin (hanya lab)
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Token API bootstrap (openssl). Dipakai skrip bootstrap_authentik.py
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_TAG=2026.8.0
# Host publik Authentik (brand / issuer). Harus sama dengan URL yang diketik.
# Jalur A: http://localhost:9000   Jalur B: https://sia.caracal-bee.ts.net
AUTHENTIK_HOST=
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# --- OpenSearch 3.5.0 ---
# Password admin awal wajib memenuhi aturan kompleksitas OpenSearch
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
OPENSEARCH_ADMIN_PASSWORD=
OPENSEARCH_KIBANASERVER_PASSWORD=
OPENSEARCH_AUDIT_VIEWER_PASSWORD=
OPENSEARCH_FLUENTBIT_PASSWORD=

# --- Postgres Dashboard (image postgres:17-alpine) ---
DASH_POSTGRES_USER=orcastra
DASH_POSTGRES_DB=orcastra
DASH_POSTGRES_PASSWORD=
# Contoh: postgresql://orcastra:<DASH_POSTGRES_PASSWORD>@postgres:5432/orcastra
DATABASE_URL=

# --- Dashboard frontend/backend RC4 ---
APP_VERSION=1.0.0-RC4
NEXT_PUBLIC_APP_VERSION=1.0.0-RC4
WEB_CONCURRENCY=1
BACKEND_MEM_LIMIT=1g
BACKEND_CPUS=1
NEXTAUTH_SECRET=
AUTH_SECRET=
SECRET_KEY=
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_ENCRYPTION_KEY=
INTERNAL_BACKEND_URL=http://backend:4050
AUTH_TRUST_HOST=true
AUTH_ENABLED=true

# URL yang diketik operator. Isi sama dengan AUTH_ORIGIN.
# Jalur A: http://localhost:4321
# Jalur B: https://sia.caracal-bee.ts.net
NEXTAUTH_URL=
AUTH_URL=
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=
# Logout Authentik. Jalur A: http://localhost:9000/if/flow/default-provider-invalidation-flow/
# Jalur B: ${AUTH_ORIGIN}/if/flow/default-provider-invalidation-flow/
NEXT_PUBLIC_AUTHENTIK_LOGOUT_URL=

# OIDC — isi SETELAH bootstrap_authentik.py (client_id/secret dari provider)
AUTHENTIK_API_URL=http://ak-server:9000
AUTHENTIK_API_TOKEN=
# Trailing slash wajib. Jalur A: http://localhost:9000/application/o/orcastra-dashboard/
# Jalur B: https://sia.caracal-bee.ts.net/application/o/orcastra-dashboard/
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_AUDIENCE=

# --- Vault (hashicorp/vault:1.18) ---
# VAULT_TOKEN = token dashboard (policy orcastra-policy), BUKAN root.
# Diisi SETELAH bootstrap_vault.sh. Vault sealed lagi setelah reboot host.
VAULT_ENABLED=true
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_PKI_ROLE=lxd

# --- OpenSearch dari sisi dashboard ---
OPENSEARCH_ARCHIVE_ENABLED=true
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_SSL=true
OPENSEARCH_SSL_VERIFY=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_USER=fluentbit
OPENSEARCH_ADMIN_USER=admin
OPENSEARCH_SNAPSHOT_REPO=orcastra-archive
